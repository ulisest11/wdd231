/* ===================================================
   PANAJACHEL CHAMBER — home-large.css
   Loaded for screens >= 768px
   Matches wireframe exactly
   =================================================== */

/* === HEADER: full horizontal nav === */
.nav-toggle {
    display: none;
}

.main-nav {
    display: block !important;
    position: static;
    background: transparent;
    padding: 0;
    box-shadow: none;
}

.main-nav ul {
    flex-direction: row;
    gap: 0.2rem;
    align-items: center;
}

.main-nav a {
    font-size: 0.85rem;
    padding: 0.4rem 0.65rem;
    white-space: nowrap;
}

/* === HERO: taller, Keynote Tickets button bottom-right === */
.hero {
    height: 420px;
}

.hero-overlay {
    align-items: flex-end;
    justify-content: flex-end;
    padding: 2rem;
}

.hero-content {
    text-align: right;
}

.hero-title {
    font-size: 2.6rem;
}

/* === INFO GRID: Events(wide) | Current Weather | Forecast === */
.info-grid {
    grid-template-columns: 2fr 1.4fr 1.4fr;
    align-items: start;
}

/* === BUSINESS CARDS: 3 equal columns === */
.businesses-grid {
    grid-template-columns: repeat(3, 1fr);
}

/* Tablet breakpoint */
@media (min-width: 768px) and (max-width: 900px) {
    .info-grid {
        grid-template-columns: 1fr 1fr;
    }

    .events-card {
        grid-column: 1 / -1;
    }

    .businesses-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}