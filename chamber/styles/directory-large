/* ===================================================
   PANAJACHEL CHAMBER — directory-large.css
   Screens >= 768px
   =================================================== */

/* Hide hamburger, show full nav */
.nav-toggle {
    display: none !important;
}

.main-nav {
    display: block !important;
    position: static !important;
    background: transparent !important;
    padding: 0 !important;
    box-shadow: none !important;
}

.main-nav ul {
    flex-direction: row !important;
    gap: 0.2rem;
    align-items: center;
}

.main-nav a {
    font-size: 0.85rem;
    padding: 0.4rem 0.7rem;
    white-space: nowrap;
}

/* Directory title larger */
.directory-header h1 {
    font-size: 2.6rem;
}

/* 2 columns on tablet */
.members-container.grid-view {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

/* Show address in list view */
.list-item-address {
    display: block;
    flex: 2;
}

.member-list-item {
    gap: 1rem;
}

/* 3 columns on desktop */
@media (min-width: 1024px) {
    .members-container.grid-view {
        grid-template-columns: repeat(3, 1fr);
    }

    .directory-header h1 {
        font-size: 3rem;
    }
}